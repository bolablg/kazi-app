{
  "name": "kazi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "test:deployment": "node --test scripts/hosted-environment.test.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "backend": "convex dev",
    "seed": "convex run seed:demo",
    "deploy:backend": "convex deploy",
    "deploy:frontend": "node scripts/check-production.mjs && npm run build && wrangler deploy",
    "check:deploy": "npm run build && wrangler deploy --dry-run",
    "mcp:stdio": "tsx mcp/stdio.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "format:check": "prettier --check src shared convex mcp tests scripts *.ts *.json",
    "backend:local": "tsx scripts/start-local.ts",
    "setup:local": "tsx scripts/configure-local.ts",
    "dev:local": "npm run setup:local && vite --host 127.0.0.1",
    "dev:demo": "vite --mode e2e --host 127.0.0.1 --port 5175"
  },
  "dependencies": {
    "@clerk/react": "6.18.1",
    "@dnd-kit/core": "6.3.1",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-dialog": "1.3.1",
    "convex": "1.48.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "convex-test": "0.0.65",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
