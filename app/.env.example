# Browser: configure BOTH for live mode. Otherwise a synthetic local demo runs.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CONVEX_URL=
# Convex CLI creates this after you select an authorized development project.
CONVEX_DEPLOYMENT=
# Set these on Convex, never with a VITE_ prefix:
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# APP_ORIGIN=http://localhost:5173
# CONVEX_SITE_URL=https://your-deployment.convex.site
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=base64-encoded-32-random-bytes
# INVITATION_SIGNING_KEY=at-least-32-random-characters

# Optional invitation delivery; backend only. Verify sender in Resend.
# RESEND_API_KEY=
# INVITE_EMAIL_FROM=Kazi <invites@your-domain.example>
