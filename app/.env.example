# Cloud development: place these VITE_ values in .env.development.local.
# Use a Clerk pk_test_ key and the matching Convex development URL.
# Keep frontend values out of .env.local so isolated e2e/demo builds stay isolated.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CONVEX_URL=
# Keep the existing key above for the legacy directory while identities are linked.
# Optional shared identity rehearsal; leave unset until backend trust is verified.
# Rehearsal needs backend KAZI_IDENTITY_MODE=shared while the frontend stays legacy.
# VITE_KAZI_IDENTITY_MODE=legacy
# VITE_IYANJU_CLERK_PUBLISHABLE_KEY=
# VITE_IYANJU_ACCOUNT_ORIGIN=http://127.0.0.1:49569
# Shared production uses https://iyanju.com. Hosted previews remain legacy until
# their exact account return origins and shared sessions are reviewed.
# CLI only: put CONVEX_DEPLOYMENT=dev:<deployment> in .env.local after selecting
# your development project. It must match VITE_CONVEX_URL for the local MCP proxy.
CONVEX_DEPLOYMENT=
# Hosted MCP uses /mcp on this frontend and the exact backend selected by
# convex deploy --cmd. Do not configure VITE_CONVEX_SITE_URL or an MCP upstream.
# Set these on Convex, never with a VITE_ prefix:
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# KAZI_IDENTITY_MODE=legacy
# IYANJU_CLERK_ISSUER_DOMAIN=https://your-central-instance.clerk.accounts.dev
# KAZI_IDENTITY_ENVIRONMENT=development
# KAZI_LEGACY_AUTH_ENABLED=true
# After the migration window, false retires legacy trust while preserving mappings.
# Convex auth.config requires explicit MODE and ENVIRONMENT values on deployment;
# initialize previews as legacy/preview and production as legacy/production.
# KAZI_AUTH_ORIGINS=http://127.0.0.1:5192
# APP_ORIGIN=http://127.0.0.1:5173
# CONVEX_SITE_URL=https://your-deployment.convex.site
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=base64-encoded-32-random-bytes
# INVITATION_SIGNING_KEY=at-least-32-random-characters

# Optional invitation delivery; backend only. Verify sender in Resend.
# RESEND_API_KEY=
# INVITE_EMAIL_FROM=Kazi by iYANJU <invites@your-domain.example>
